/*====================================================================
    PingLab Robot Console — Professional Dark Theme
    Design system: "Developer Tool / Operations Console"
    --------------------------------------------------------------
    Design tokens (keep every color in this table; do not invent
    new hex values elsewhere in the app):

      Window base        #0E1320
      Surface            #151B28
      Surface raised     #1C2434
      Input background   #0B101B
      Border             #2A3447
      Border subtle      #212A3B
      Text primary       #E6EBF5
      Text muted         #97A3B8
      Accent (blue)      #3D82F0   hover #5493F5   pressed #2F6BD0
      Success (green)    #16A34A   hover #1FBF5C
      Danger  (red)      #C0392B   hover #E74C3C
      Info    (light)    #6EA8FE
====================================================================*/

* {
    color: #E6EBF5;
    font-family: "Inter", "Segoe UI", "Cantarell", "DejaVu Sans", "Helvetica Neue", sans-serif;
    font-size: 10.5pt;
}

QWidget {
    background-color: #151B28;
}

MyMainWindow, QWidget#centralWidget, QDialog {
    background-color: #0E1320;
}

QLabel {
    background: transparent;
}

QToolTip {
    color: #E6EBF5;
    background-color: #1C2434;
    border: 1px solid #3D82F0;
    border-radius: 4px;
    padding: 6px 8px;
}

/*====================================================================
    MENU, TOOLBAR, STATUSBAR
====================================================================*/

QMenuBar {
    background-color: #0E1320;
    border-bottom: 1px solid #212A3B;
    padding: 2px;
}
QMenuBar::item {
    background-color: transparent;
    padding: 6px 14px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #1C2434;
    color: #FFFFFF;
}
QMenuBar::item:pressed {
    background-color: #3D82F0;
    color: #FFFFFF;
}

QMenu {
    background-color: #1C2434;
    border: 1px solid #2A3447;
    border-radius: 6px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 28px 6px 16px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #3D82F0;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background: #2A3447;
    margin: 6px 8px;
}

QToolBar {
    background-color: #0E1320;
    border: none;
    border-bottom: 1px solid #212A3B;
    padding: 3px 6px;
    spacing: 2px;
}
QToolBar::separator {
    background: #2A3447;
    width: 1px;
    margin: 6px 6px;
}
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 6px;
    margin: 1px;
}
QToolButton:hover, QToolButton:checked {
    background-color: #1C2434;
    border: 1px solid #2A3447;
}
QToolButton:pressed {
    background-color: #2F6BD0;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #0E1320;
    border-top: 1px solid #212A3B;
}
QStatusBar QLabel {
    color: #97A3B8;
    padding: 0 6px;
    background: transparent;
}
QStatusBar::item {
    border: none;
}

/*====================================================================
    MAIN LAYOUT (SPLITTERS, FRAMES)
====================================================================*/

QSplitter::handle {
    background-color: #0E1320;
}
QSplitter::handle:hover,
QSplitter::handle:pressed {
    background-color: #3D82F0;
}

QFrame#sidebar {
    background-color: #10161F;
    border: none;
    border-left: 1px solid #212A3B;
}

/*====================================================================
    GROUP BOXES  (section cards)
====================================================================*/

QGroupBox {
    color: #6EA8FE;
    border: 1px solid #212A3B;
    border-radius: 6px;
    margin-top: 1.4em;
    padding-top: 4px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    background-color: transparent;
    letter-spacing: 0.5px;
}

/*====================================================================
    TABS  (flat, accent-underline style)
====================================================================*/

QTabWidget::pane {
    border: none;
    border-top: 1px solid #212A3B;
}
QTabBar {
    background: transparent;
    font-weight: 600;
}
QTabBar::tab {
    background: transparent;
    color: #97A3B8;
    padding: 8px 18px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 2px;
}
QTabBar::tab:hover {
    color: #E6EBF5;
    background: #1C2434;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}
QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #3D82F0;
}
QTabBar::tab:disabled {
    color: #4A576C;
}

/*====================================================================
    BUTTONS
====================================================================*/

QPushButton {
    background-color: #232C3F;
    color: #E6EBF5;
    border: 1px solid #2E3950;
    border-radius: 5px;
    padding: 6px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #2B3550;
    border-color: #3A4763;
}
QPushButton:pressed {
    background-color: #2F6BD0;
    border-color: #2F6BD0;
    color: #FFFFFF;
}
QPushButton:checked {
    background-color: #2F6BD0;
    border-color: #3D82F0;
    color: #FFFFFF;
}
QPushButton:disabled {
    background-color: #1A2130;
    border-color: #212A3B;
    color: #5B6779;
}
QPushButton:focus {
    border: 1px solid #3D82F0;
}

/* Semantic action buttons (set via objectName) */
QPushButton#btnStart {
    background-color: #16A34A;
    border-color: #16A34A;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#btnStart:hover {
    background-color: #1FBF5C;
}
QPushButton#btnStop {
    background-color: #C0392B;
    border-color: #C0392B;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#btnStop:hover {
    background-color: #E74C3C;
}

/*====================================================================
    INPUTS (LINE EDITS, TEXT AREAS, LISTS)
====================================================================*/

QLineEdit, QTextEdit, QPlainTextEdit, QListWidget {
    background-color: #0B101B;
    border: 1px solid #2A3447;
    border-radius: 5px;
    padding: 5px 8px;
    selection-background-color: #2F6BD0;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus {
    border: 1px solid #3D82F0;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #131926;
    color: #5B6779;
}

QTextEdit#logDisplay {
    font-family: "JetBrains Mono", "Cascadia Code", "DejaVu Sans Mono", "Monospace", monospace;
    font-size: 9.5pt;
    color: #B9C4D6;
    background-color: #0B101B;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}
QListWidget::item:hover {
    background-color: #1C2434;
}
QListWidget::item:selected {
    background-color: #2F6BD0;
    color: #FFFFFF;
}

/*====================================================================
    COMBO BOXES
====================================================================*/

QComboBox {
    background-color: #232C3F;
    border: 1px solid #2E3950;
    border-radius: 5px;
    padding: 5px 10px;
    min-height: 20px;
}
QComboBox:hover {
    border-color: #3D82F0;
}
QComboBox:focus {
    border: 1px solid #3D82F0;
}
QComboBox:disabled {
    background-color: #1A2130;
    color: #5B6779;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #97A3B8;
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1C2434;
    border: 1px solid #2A3447;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #2F6BD0;
    selection-color: #FFFFFF;
    outline: none;
}

/*====================================================================
    SPIN BOXES
====================================================================*/

QSpinBox, QDoubleSpinBox {
    background-color: #0B101B;
    border: 1px solid #2A3447;
    border-radius: 5px;
    padding: 4px 6px;
    selection-background-color: #2F6BD0;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #3D82F0;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #131926;
    color: #5B6779;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #232C3F;
    border: none;
    width: 18px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    border-top-right-radius: 4px;
    border-bottom: 1px solid #151B28;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    border-bottom-right-radius: 4px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #2B3550;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #97A3B8;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #97A3B8;
}

/*====================================================================
    CHECK BOXES & RADIO BUTTONS
====================================================================*/

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3A4763;
    background-color: #0B101B;
}
QCheckBox::indicator {
    border-radius: 4px;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #3D82F0;
}
QCheckBox::indicator:checked {
    background-color: #3D82F0;
    border-color: #3D82F0;
}
QRadioButton::indicator:checked {
    background-color: #3D82F0;
    border: 4px solid #0B101B;
    outline: 1px solid #3D82F0;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #131926;
    border-color: #212A3B;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: #5B6779;
}

/*====================================================================
    SLIDERS
====================================================================*/

QSlider {
    background: transparent;
    min-height: 22px;
}
QSlider::groove:horizontal {
    height: 4px;
    background: #2A3447;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: #3D82F0;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -5px 0;
    background: #E6EBF5;
    border: 2px solid #3D82F0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #FFFFFF;
    border-color: #5493F5;
}
QSlider::groove:vertical {
    width: 4px;
    background: #2A3447;
    border-radius: 2px;
}
QSlider::handle:vertical {
    width: 14px;
    height: 14px;
    margin: 0 -5px;
    background: #E6EBF5;
    border: 2px solid #3D82F0;
    border-radius: 8px;
}

/*====================================================================
    TABLES & TREES
====================================================================*/

QTableWidget, QTableView {
    background-color: #0B101B;
    alternate-background-color: #10161F;
    border: 1px solid #212A3B;
    border-radius: 5px;
    gridline-color: #212A3B;
}
QTableWidget::item, QTableView::item {
    padding: 4px 6px;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #2F6BD0;
    color: #FFFFFF;
}
QHeaderView {
    background-color: #151B28;
}
QHeaderView::section {
    background-color: #1C2434;
    color: #97A3B8;
    border: none;
    border-right: 1px solid #212A3B;
    border-bottom: 1px solid #212A3B;
    padding: 6px 8px;
    font-weight: 600;
}
QTableCornerButton::section {
    background-color: #1C2434;
    border: none;
}

QTreeWidget, QTreeView {
    background-color: #0B101B;
    border: none;
    alternate-background-color: #10161F;
}
QTreeWidget::item, QTreeView::item {
    color: #E6EBF5;
    padding: 5px;
}
QTreeWidget::item:hover, QTreeView::item:hover {
    background-color: #1C2434;
}
QTreeWidget::item:selected, QTreeView::item:selected {
    background-color: #2F6BD0;
    color: #FFFFFF;
}

/*====================================================================
    SCROLL BARS  (slim, rounded)
====================================================================*/

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #2E3950;
    border-radius: 3px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #3A4763;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #2E3950;
    border-radius: 3px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #3A4763;
}
QScrollBar::add-line, QScrollBar::sub-line {
    height: 0px;
    width: 0px;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/*====================================================================
    PROGRESS BAR
====================================================================*/

QProgressBar {
    background-color: #0B101B;
    border: 1px solid #2A3447;
    border-radius: 5px;
    text-align: center;
    color: #E6EBF5;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: #3D82F0;
    border-radius: 4px;
}

/*====================================================================
    SCROLL AREA / MISC
====================================================================*/

QScrollArea {
    border: none;
    background: transparent;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}

QDialogButtonBox QPushButton {
    min-width: 84px;
}
